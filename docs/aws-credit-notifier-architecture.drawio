        </mxCell>
        <mxCell id="step-4-desc" parent="step-4-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Slack へ通知&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Lambda が Slack の chat.postMessage API に Block Kit メッセージを送信し、クレジットレポートやアラートをチャンネルへ配信します。&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>
